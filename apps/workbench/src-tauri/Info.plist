<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tauri 会把这个文件与 CLI 生成的 Info.plist 合并（见 macOS 打包文档）。

  为什么必须有：语音笔记要用 getUserMedia 采集麦克风。macOS 在应用没有
  NSMicrophoneUsageDescription 时会直接终止进程——不是弹权限框，而是崩溃。
  这条声明既是权限文案，也是不崩的前提。

  这里只放「补充键」，不重复 Tauri 已经生成的身份/版本字段，避免冲突。
-->
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>用于把手写与语音直接记成笔记：录音只保存在本机，转写用本地模型，音频不会上传。</string>
</dict>
</plist>
