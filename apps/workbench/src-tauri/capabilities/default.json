{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面窗口可以调用卡库文件命令和选择目录",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-load-store",
    "allow-save-cards",
    "allow-save-settings",
    "allow-save-search-history",
    "allow-read-archive",
    "allow-read-api-key",
    "allow-write-api-key",
    "allow-export-archive",
    "allow-fetch-clip",
    "allow-read-text-file",
    "allow-complete-chat",
    "allow-open-url",
    "allow-db-load-cards",
    "allow-db-upsert-card",
    "allow-db-delete-card",
    "allow-db-search-cards-fts",
    "allow-db-save-material",
    "allow-db-list-materials",
    "allow-db-update-material-status",
    "allow-db-get-stats"
  ]
}
